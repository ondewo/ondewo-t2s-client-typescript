{
	"name": "@ondewo/t2s-client-typescript",
	"version": "6.6.0",
	"description": "ONDEWO Text to Speech (T2S) Client library for Typescript",
	"author": "ONDEWO GmbH <office@ondewo.com>",
	"homepage": "https://ondewo.com",
	"license": "Apache-2.0",
	"keywords": [
		"ondewo",
		"t2s",
		"api",
		"client",
		"typescript",
		"grpc"
	],
	"main": "public-api.js",
	"typings": "public-api.d.ts",
	"scripts": {
		"start": "npm run build",
		"build": "docker run -v ${PWD}:/input-volume -v ${PWD}/..:/output-volume ondewo-typescript-proto-compiler ondewo-t2s-api ondewo",
		"predebug": "mv ondewo-t2s-api/googleapis/google ondewo-t2s-api/google",
		"debug": "docker run --entrypoint /bin/bash -v ${PWD}:/input-volume -v ${PWD}/..:/output-volume ondewo-typescript-proto-compiler",
		"pretest": "rm -rf .test-build && tsc -p tsconfig.test.json && cp -R api .test-build/api",
		"test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --all --src .test-build --include '.test-build/auth/**/*.js' --include '.test-build/examples/**/*.js' --exclude '**/*.spec.js' --reporter text node --test .test-build/auth/offlineTokenProvider.spec.js .test-build/examples/ts-client.spec.js"
	},
	"repository": {
		"type": "git",
		"directory": "https://github.com/ondewo/ondewo-t2s-client-typescript"
	},
	"dependencies": {
		"google-protobuf": "3.21.4",
		"grpc-web": "^1.5.0",
		"tslib": "^2.8.1",
		"undici": "^6.27.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.27",
		"@typescript-eslint/eslint-plugin": "^8.63.0",
		"c8": "^11.0.0",
		"dotenv": "^16.4.5",
		"eslint": "^9.39.4",
		"global": "^4.4.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.4",
		"typescript": "^6.0.3"
	}
}
